  "static_behavior": {
    "ur-rtde-servoj": [
      "Control connection and initial joint movement occur at module top level before the loop cleanup block.",
      "The indefinite loop computes sinusoidal six-joint targets using elapsed wall-clock time.",
      "The requested period is 1/500 seconds; no achieved frequency or real-time scheduling is measured.",
      "The loop cleanup calls servoStop and stopScript. The loopback demonstration address does not establish a simulator-only environment."
    ],
    "ur-rtde-io": [
      "Top-level connection uses the embedded demonstration controller address.",
      "Output-state indices 7 and 16 are read; standard output 7 and tool output 0 are set high.",
      "After a 0.01-second wait and another state read, analog output 1 is set to current ratio 0.25.",
      "Prior output values are not restored. Connected peripherals may actuate."
    ]
  },
