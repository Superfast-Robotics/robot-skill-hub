{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hub.superfastrobotics.com/schemas/project-policy.schema.json",
  "title": "Robot Skill Hub project sharing policy",
  "description": "Project-local authorization. A token or patch-publication authorization does not authorize public memory saving.",
  "type": "object",
  "properties": {
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_save_allowed"
      ],
      "properties": {
        "public_save_allowed": {
          "type": "boolean"
        },
        "allowed_skill_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          }
        },
        "allowed_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "failure_observation",
              "missing_requirement",
              "working_workaround",
              "compatibility_note",
              "docs_correction",
              "successful_invocation"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "public_save_allowed": {
                "const": true
              }
            },
            "required": [
              "public_save_allowed"
            ]
          },
          "then": {
            "required": [
              "allowed_skill_ids",
              "allowed_kinds"
            ]
          }
        }
      ]
    },
    "publication": {
      "type": "object",
      "properties": {
        "public_submission_allowed": {
          "type": "boolean"
        },
        "allowed_skill_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
