{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hub.superfastrobotics.com/schemas/execution-interface.schema.json",
  "title": "Robot Skill Hub executable interface v1",
  "description": "Language-independent operation contract. Abstraction level is independent of runtime evidence. Input/output schemas use the documented bounded data subset; local tooling additionally validates schema structure and actual handoffs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "abstraction_level",
    "execution_domain",
    "language",
    "input_transport",
    "output_transport",
    "output_selector",
    "conventions",
    "input_schema",
    "output_schema",
    "preconditions",
    "postconditions",
    "failure_codes",
    "composition"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "kind": {
      "enum": [
        "algorithm",
        "controller",
        "sensing",
        "trajectory_generator",
        "task",
        "workflow"
      ]
    },
    "abstraction_level": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3
      ]
    },
    "execution_domain": {
      "enum": [
        "computation",
        "simulation",
        "hardware"
      ]
    },
    "language": {
      "enum": [
        "python",
        "rust",
        "cpp",
        "other"
      ]
    },
    "input_transport": {
      "enum": [
        "json_file_or_inline",
        "cli_arguments"
      ]
    },
    "output_transport": {
      "const": "json_stdout"
    },
    "output_selector": {
      "enum": [
        "root",
        "outputs"
      ]
    },
    "conventions": {
      "type": "object",
      "required": [
        "linear_unit",
        "angular_unit",
        "time_unit",
        "coordinate_frame",
        "joint_order",
        "quaternion_order"
      ],
      "additionalProperties": false,
      "properties": {
        "linear_unit": {
          "const": "m"
        },
        "angular_unit": {
          "const": "rad"
        },
        "time_unit": {
          "const": "s"
        },
        "coordinate_frame": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "joint_order": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "quaternion_order": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        }
      }
    },
    "input_schema": {
      "type": "object",
      "required": [
        "type",
        "properties",
        "required",
        "additionalProperties"
      ]
    },
    "output_schema": {
      "type": "object",
      "required": [
        "type",
        "properties",
        "required",
        "additionalProperties"
      ]
    },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1500
      }
    },
    "postconditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1500
      }
    },
    "failure_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1500
      }
    },
    "origin_reference_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
      }
    },
    "origin_relationship": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "argument_map": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1500
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depends_on",
        "automatic_frame_conversion",
        "automatic_hardware_execution"
      ],
      "properties": {
        "depends_on": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          }
        },
        "automatic_frame_conversion": {
          "const": false
        },
        "automatic_hardware_execution": {
          "const": false
        }
      }
    }
  }
}
