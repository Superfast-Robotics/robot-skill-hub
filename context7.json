{
  "$schema": "https://context7.com/schema/context7.json",
  "projectTitle": "Robot Skill Hub",
  "description": "Reusable robotics implementations and exact-source findings for coding agents. Search and inspect pinned planning, kinematics, filtering and trajectory code without an account; prepare supported recipes locally; recall and share scoped contributor-reported experience. Includes reproducible problem cases and ROS-MCP/LangChain integration examples.",
  "folders": [
    "docs",
    "skills/find-robot-skills",
    "skills/robot-motion-planning",
    "skills/robot-kinematics",
    "skills/robot-trajectory"
  ],
  "excludeFolders": [
    "skills/find-robot-skills/assets",
    "skills/find-robot-skills/scripts",
    "skills/find-robot-skills/schemas",
    "skills/robot-motion-planning/scripts",
    "skills/robot-kinematics/scripts",
    "skills/robot-trajectory/scripts"
  ],
  "excludeFiles": [
    "growth-status.md",
    "deployment.md",
    "discovery-submissions.md",
    "verification.md",
    "sample-sources.md",
    "workflow-sources.md",
    "agent-skill-sources.md",
    "robot-agent-policy-sources.md",
    "canonical-policy-sources.md",
    "platform-sources-review.md"
  ]
}
