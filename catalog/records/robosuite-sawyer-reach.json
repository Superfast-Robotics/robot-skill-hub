    "api_keys": [],
    "network": [
      "Pinned source archive during preparation",
      "PyPI dependencies during explicit installation"
    ],
    "dependency_lock": "Direct runtime versions are pinned and measured. The receipt retains the complete environment freeze; prepare records the installed environment. System drivers are separate host requirements. Linux device dependencies may build evdev from source; an available C compiler and explicit dependency-install permission are required."
  },
  "invocation": {
    "entrypoint": "python run.py",
    "argv": [
      "{python}",
      "{recipe_dir}/run.py",
      "--source-dir",
      "{source_dir}",
      "--example"
    ],
    "inputs": {
      "seed": 0,
      "offset_xyz_m": [
        0.05,
        0.02,
        0.04
      ]
    },
    "outputs": {
      "format": "single JSON object",
      "payload_selector": "outputs",
      "schema": {
        "type": "object",
        "required": [
          "final_xyz_m",
          "target_xyz_m",
          "error_m"
        ],
        "properties": {
          "final_xyz_m": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -10,
              "maximum": 10
            },
            "x-unit": "m",
            "x-frame": "right_handed_world_xyz; +z_up",
            "x-order": [
              "x",
              "y",
              "z"
            ]
          },
          "target_xyz_m": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -10,
              "maximum": 10
            },
            "x-unit": "m",
            "x-frame": "right_handed_world_xyz; +z_up",
            "x-order": [
              "x",
              "y",
              "z"
            ]
          },
          "error_m": {
            "type": "number",
            "minimum": 0,
            "maximum": 20,
            "x-unit": "m"
          }
        },
        "additionalProperties": false
      }
    },
    "example": "Prepare explicitly; run --example or replace it with --input TASK.json. --describe reads the bounded contract without running simulation."
